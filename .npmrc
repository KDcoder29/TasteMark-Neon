# @neondatabase/neon-js -> better-auth lists "vitest" as a peer dependency. With vitest installed
# (our test runner), npm's peer resolver crashes on a clean install:
#   "Cannot read properties of null (reading 'edgesOut' / 'children')"
# which broke the Vercel build. Legacy peer mode skips that step; the lockfile is unchanged.
legacy-peer-deps=true
